# Copie para .env e preencha. O .env NAO e versionado.

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sortifyteams
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — segredo HMAC em Base64, minimo 32 bytes (ex.: openssl rand -base64 48)
JWT_SECRET=Q29sZS1hcXVpLXVtLXNlZ3JlZG8tYWxlYXRvcmlvLWVtLWJhc2U2NC0hIQ==
# JWT_EXPIRATION_MS=900000
# REFRESH_TOKEN_EXPIRATION_MS=2592000000

# Armazenamento de fotos (disco local no MVP)
# STORAGE_PATH=uploads

# URL base publica (producao, atras de proxy)
# APP_BASE_URL=

# Deep link do app (convite de racha)
